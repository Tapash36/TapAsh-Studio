{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Studio Server (FastAPI + UI on Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on (http://[^\\s]+)",
        "uriFormat": "http://localhost:8000",
        "action": "openExternally"
      }
    }
  ]
}
