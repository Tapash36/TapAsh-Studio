{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend API (Port 8000)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m uvicorn backend.app:app --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Frontend UI (Port 3000)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m http.server 3000 --directory frontend",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Full Studio (Backend + Frontend)",
      "dependsOn": [
        "Start Backend API (Port 8000)",
        "Start Frontend UI (Port 3000)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
